{
	"name": "prestige-frontend",
	"version": "0.0.1",
	"description": "Just an HTTP client, by Shrikant.",
	"author": "Shrikant Sharat Kandula <shrikantsharat.k@gmail.com>",
	"license": "Apache-2.0",
	"private": true,
	"bugs": {
		"url": "https://github.com/sharat87/prestige/issues"
	},
	"homepage": "https://github.com/sharat87/prestige",
	"_comment_browserslist": [
		"Firefox 78 is default on Debian stable], at https://packages.debian.org/search?keywords=firefox-esr"
	],
	"browserslist": [
		"last 2 Chrome versions",
		"Firefox >= 78",
		"last 2 Edge versions",
		"last 2 Safari versions"
	],
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "jsdom",
		"moduleNameMapper": {
			"^_/(.*)$": "<rootDir>/src/scripts/$1",
			"\\.css$": "<rootDir>/identity-proxy.js"
		},
		"collectCoverage": true
	},
	"eslintConfig": {
		"env": {
			"browser": true,
			"es6": true
		},
		"extends": [
			"eslint:recommended",
			"plugin:@typescript-eslint/recommended"
		],
		"overrides": [
			{
				"files": [
					"src/tests/*.ts"
				],
				"rules": {
					"@typescript-eslint/no-non-null-assertion": "off"
				}
			}
		],
		"parser": "@typescript-eslint/parser",
		"parserOptions": {
			"ecmaVersion": 11,
			"sourceType": "module",
			"project": "tsconfig.json"
		},
		"plugins": [
			"@typescript-eslint"
		],
		"rules": {
			"indent": [
				"error",
				"tab"
			],
			"no-tabs": [
				"error",
				{
					"allowIndentationTabs": true
				}
			],
			"max-len": "off",
			"linebreak-style": [
				"error",
				"unix"
			],
			"no-unused-vars": "off",
			"@typescript-eslint/no-unused-vars": "error",
			"no-unused-expressions": "off",
			"@typescript-eslint/no-unused-expressions": "error",
			"quotes": "off",
			"@typescript-eslint/quotes": [
				"error",
				"double",
				{
					"avoidEscape": true
				}
			],
			"semi": "off",
			"@typescript-eslint/semi": [
				"error",
				"never"
			],
			"comma-dangle": "off",
			"@typescript-eslint/comma-dangle": [
				"error",
				"always-multiline"
			],
			"capitalized-comments": [
				"error",
